AUTH_SECRET=replace-with-a-32-byte-hex-secret
NEXTAUTH_SECRET=replace-with-a-32-byte-hex-secret
NEXTAUTH_URL=http://localhost:3000
AUTH_URL=http://localhost:3000

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail_address@gmail.com
SMTP_PASS=your_16_char_app_password
SMTP_FROM="Enterprise ERP Auth <your_gmail_address@gmail.com>"

